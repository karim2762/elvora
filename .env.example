# ---- Server ----
PORT=4000
NODE_ENV=development
# Browser origin(s) allowed to call the API (comma-separated). Also used for the CSRF Origin check.
CORS_ORIGIN=http://localhost:5173
# Public URL of the web app, used to build password-reset links.
CLIENT_URL=http://localhost:5173

# SQLite file (relative paths resolve from /server). Use file::memory: for a throwaway DB.
DATABASE_URL=file:./data/elevora.db

# REQUIRED in production (32+ random chars): openssl rand -hex 32
# In development a temporary secret is generated, so sessions reset on restart.
SESSION_SECRET=
# lax (default) | strict | none. Use "none" only if the API is on a different site (forces Secure cookies).
# COOKIE_SAMESITE=lax
# Set to 1 (or the hop count) when running behind a reverse proxy so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Password-reset link lifetime
RESET_TOKEN_TTL_MINUTES=30

# Rate limits (per 15-minute window unless stated)
# RATE_LIMIT_LOGIN_MAX=10          failed logins per IP
# RATE_LIMIT_LOGIN_ACCOUNT_MAX=5   failed logins per IP + email
# RATE_LIMIT_REGISTER_MAX=10       sign-ups per IP per hour
# RATE_LIMIT_PAYMENT_WRITE_MAX=30  payment orders / UTR submissions per student per window (Stage 10C)
# RATE_LIMIT_PAYMENT_UPLOAD_MAX=20 payment-proof uploads per student per window (Stage 10C)
# RATE_LIMIT_ADMIN_PAYMENT_WRITE_MAX=200  admin payment decisions/config/refunds per administrator per window (Stage 10C)
# RATE_LIMIT_ADMIN_EXPORT_MAX=20   financial report views + CSV exports per administrator per window (Stage 10C)
# RATE_LIMIT_FORGOT_MAX=5
# RATE_LIMIT_RESET_MAX=10

# ---- Email (optional) ----
# Password-reset emails are sent ONLY when SMTP_HOST and MAIL_FROM are set.
# Without them the API says plainly that no email was sent.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ELVORA <no-reply@your-domain.com>"
# Development only (ignored in production): print reset links to the server console when email is not configured.
DEV_LOG_RESET_LINKS=true

# ---- Client (build-time, must start with VITE_) ----
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
VITE_USE_DEMO_DATA=false

# ---- Stage 04B: applications ----
# Enables the administrator API (PATCH /api/v1/admin/applications/:id/status). 32+ random chars: openssl rand -hex 32
# Leave empty to keep the admin API switched off. Never expose this value to the browser.
# Admin key for the admin console at /admin (32+ characters). Generate one with:  npm run admin:key
ADMIN_API_KEY=
# The key is READ-ONLY. Set to true only as a temporary bridge for old scripts that still change data with X-Admin-Key (audited by fingerprint).
# ADMIN_API_KEY_ALLOW_WRITES=false
# RATE_LIMIT_APPLY_MAX=10               application submissions per student per hour
# RATE_LIMIT_APPLICATION_READ_MAX=120   application reads per student per 15 minutes
# RATE_LIMIT_ADMIN_MAX=10               failed admin-key attempts per IP per 15 minutes

# ---- Stage 05C: documents ----
# Private folder for officially issued PDFs (relative paths resolve from /server). Never served statically; keep it out of git and back it up.
# DOCUMENTS_DIR=./storage/documents
# MAX_DOCUMENT_MB=5
# RATE_LIMIT_PASSWORD_CHANGE_MAX=5   wrong current-password attempts per student per window
# RATE_LIMIT_UNREAD_POLL_MAX=300     header-bell polls per student per window
# RATE_LIMIT_PUBLIC_VERIFY_MAX=60        public document-verification lookups per IP per window
# RATE_LIMIT_PUBLIC_VERIFY_MISS_MAX=15   of those, lookups that find nothing per IP per window (anti-guessing)
# Document QR codes encode CLIENT_URL/verify/<reference>: set CLIENT_URL to your real https:// address in production (the server refuses http there).

# ---- Stage 06A: organization identity on official documents ----
# Nothing is invented: empty values show a visible [placeholder] in previews, and real issuance (Stage 06B) is blocked until
# ORG_ADDRESS, ORG_EMAIL, ORG_SIGNATORY_NAME and ORG_SIGNATORY_TITLE are set.
# ORG_NAME=ELVORA
# ORG_LEGAL_NAME=
# ORG_LOGO_PATH=            optional PNG/JPEG/SVG up to 1 MB (relative to /server); the built-in ELVORA mark is used when empty
# ORG_ADDRESS=
# ORG_EMAIL=
# ORG_WEBSITE=https://
ORG_SIGNATORY_NAME=Gowtham
ORG_SIGNATORY_TITLE=Chief Executive Officer (CEO)
# The signatory is drawn as a handwritten-style signature (bold initials, a scribble for the surname, a looped underline) above the signing line;
# the full name is printed in plain type below it. Set to false for a blank line.
# ORG_SIGNATURE_ENABLED=true
# A registration line (company / MSME / Udyam / other) is printed ONLY when all three are set and VERIFIED is exactly "true".
# ORG_REGISTRATION_LABEL=
# ORG_REGISTRATION_NUMBER=
# ORG_REGISTRATION_VERIFIED=false
# ORG_DOC_FOOTER=
# ORG_COLOR_PRIMARY=#1D4ED8
# ORG_COLOR_ACCENT=#0F766E
# ORG_COLOR_INK=#101827

# ---- Stage 07: automation (offer letters, internship start, certificates after admin approval, e-mail) ----
# The worker runs inside the API process. Turn it off with AUTOMATION_ENABLED=false (then nothing is issued automatically).
# AUTOMATION_ENABLED=true
# AUTOMATION_INTERVAL_MINUTES=5      how often the worker looks for work (an admin approval also triggers it immediately)
# AUTO_ENROLL=true                   create the internship record when an application is approved
# AUTO_START_DELAY_DAYS=3            default start date = approval day + this many days
# AUTO_ACTIVATE=true                 Awaiting Start -> Active on the start date
# OFFER_SLA_HOURS=24                 offer letters later than this are flagged "overdue" in Admin -> Certificates -> Automation
# DOCUMENT_EMAILS=true               e-mail the PDF to the student (needs SMTP_HOST and MAIL_FROM above)

# ---- Stage 07A: administrator accounts ----
# No variable is needed. Authorize administrators on the server with:  npm run admin:create -- --email you@example.com --name "Your Name"
# They sign in at /admin/login. ADMIN_API_KEY (above) still unlocks the older console at /admin for scripts and emergencies.
# RATE_LIMIT_TASK_SUBMIT_MAX=30          task submissions per student per hour

# ---- Stage 09C Part 1: GitHub integration (all optional; without them the app works and shows "GitHub setup required") ----
# Server-side ONLY. Never put these in a VITE_ variable. Full setup steps: README -> "GitHub integration".
# GITHUB_APP_ID=                      numeric App ID of the ELVORA GitHub App
# GITHUB_APP_PRIVATE_KEY=             the App's PEM private key (a single line with \n escapes is accepted)
# GITHUB_CLIENT_ID=                   the GitHub App's client ID (student sign-in)
# GITHUB_CLIENT_SECRET=               the GitHub App's client secret
# GITHUB_ORGANIZATION=                organization that owns student repositories (the App must be installed on it)
# GITHUB_CALLBACK_URL=                https://<api-host>/api/v1/student/github/callback  (must match the App's callback URL exactly)
# GITHUB_WEBHOOK_SECRET=              random string (openssl rand -hex 32); same value in the App's webhook settings
# GITHUB_REPOSITORY_VISIBILITY=private    private | internal | public
# GITHUB_DEFAULT_REPOSITORY_PERMISSION=push   pull | triage | push  (students never get more than write access)
# GITHUB_REVIEW_TEAM=                 optional team slug that receives read access to every created repository
# GITHUB_TOKEN_ENCRYPTION_KEY=        optional (openssl rand -hex 32); user tokens are encrypted with a key derived from this, or from SESSION_SECRET if empty

# ---- Stage 10C: tasks ----
# AUTO_LIBRARY_TASKS=true            an internship with NO tasks configured gets the published library tasks for its category (set false to turn off)

# ---- Stage 10C Part 2: certificate corrections ----
# SUPER_ADMIN_EMAILS=                comma-separated e-mails of administrator accounts allowed to grant/revoke the 'certificate.correct' permission
#                                    (node scripts/certificate-permission.mjs grant|revoke|list <adminEmail> --by <superAdminEmail>). Empty = nobody can change it.
#                                    A correction needs TWO administrators with that permission: one creates it, a different one approves it.

# ---- Stage 10D: public priority certificate + automatic APPLICATION approval ----
# PRIORITY_PUBLIC_ACCESS=true         DEFAULT true: every signed-in student can open /priority-certificate without an invitation link. Set false to require invitations.
# AUTO_APPROVE_APPLICATIONS=false     true = approve applications automatically when EVERY condition below holds (otherwise they wait for an administrator)
#                                     Never rejects anyone. Uses the existing application evaluation (profile complete, required skills, seat free, in the window, account active, no duplicate).
# AUTO_APPROVE_DELAY_MINUTES=0        wait this long after submission before approving (0 = right away); gives an administrator time to look first
# AUTO_APPROVE_MAX_ACTIVE=1           a student may hold at most this many unfinished internships (approved/awaiting start/active)
# AUTO_APPROVE_ALLOW_MANUAL_CHECKS=true   false = listings that have free-text prerequisites a computer cannot check are never auto-approved
# AUTO_APPROVE_INTERNSHIPS=*          * = every listing, or comma-separated listing IDs, e.g. ELV-PY-001,ELV-WD-001
# AUTO_APPROVE_MAX_DURATION_DAYS=0    0 = no limit; e.g. 60 = internships longer than 60 days still wait for a person

# Local testing only (ignored in production): lets the account that submitted a project also review it.
# ALLOW_SELF_REVIEW=true

# ======================= PRODUCTION (Stage 11A) — placeholders only, never real values =======================
# NODE_ENV=production
# SESSION_SECRET=<openssl rand -hex 32>          (>=32 chars, required)
# CORS_ORIGIN=https://<your-frontend-origin>     (exact origin, https, no trailing slash)
# CLIENT_URL=https://<your-frontend-origin>      (printed in document QR codes; must be https)
# TRUST_PROXY=1                                  (hop count; see docs/DEPLOYMENT.md)
# Persistent disk paths (absolute paths are accepted):
# DATABASE_URL=file:/var/data/elevora.db
# DOCUMENTS_DIR=/var/data/documents
# PAYMENT_PROOF_DIR=/var/data/payment-proofs
# Client build-time (Vercel/Netlify project settings): VITE_API_URL=/api/v1 when /api is proxied (same origin),
# or https://api.<your-domain>/api/v1 when the API has its own subdomain.
# DEV_LOG_RESET_LINKS must be absent or false in production (it is ignored there anyway).
